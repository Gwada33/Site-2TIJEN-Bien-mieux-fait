# ============================================================
# 2TIJEN — Variables du serveur (Podman home server)
# Copie ce fichier en .env puis remplis les valeurs.
#   cp .env.example .env
# ============================================================

# --- Postgres (volume local) ---
POSTGRES_PASSWORD=change-me-strong-password

# --- Backend Medusa ---
# Secrets (génère-les : openssl rand -base64 32)
JWT_SECRET=change-me-32-bytes-random
COOKIE_SECRET=change-me-32-bytes-random

# CORS : domaines EXACTS (via le tunnel Cloudflare)
STORE_CORS=https://2tijen.com,https://www.2tijen.com
AUTH_CORS=https://2tijen.com,https://www.2tijen.com
ADMIN_CORS=https://api.2tijen.com

# Stockage des images — Cloudflare R2 (recommandé, sinon stockage local
# persistant via le volume docker backend-static)
S3_BUCKET=
S3_PUBLIC_URL=https://cdn.2tijen.com
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Storefront (inlinées au build → rebuild après changement) ---
NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://api.2tijen.com
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_xxxxx
NEXT_PUBLIC_DEFAULT_REGION=gf
NEXT_PUBLIC_BASE_URL=https://2tijen.com
NEXT_PUBLIC_HERO_VIDEO_URL=https://cdn.shopify.com/videos/c/o/v/375027fc8d1c4096adb00a4ad08b834d.mp4
NEXT_PUBLIC_HERO_LOGO_URL=
NEXT_PUBLIC_NEXT_DROP_DATE=
NEXT_PUBLIC_STRIPE_KEY=

# --- Cloudflare Tunnel (Zero Trust → Tunnels → Create → copie le token) ---
CLOUDFLARE_TUNNEL_TOKEN=eyJhIjoi…
