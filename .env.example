# ============================================================
# 2TIJEN — Variables d'environnement (exemple, à copier en .env)
# Stack cible : Coolify (Postgres + Redis + Backend + Storefront)
# Sans tunnel, sans Cloudflare — Coolify publie les ports.
# ============================================================
# Les valeurs marquées  "À COMPLÉTER"  doivent être générées / choisies.

# --- Postgres (utilisé par docker-compose ET par le service Coolify Postgres) -
POSTGRES_USER=medusa
POSTGRES_DB=medusa-store
POSTGRES_PASSWORD=à-compléter-mot-de-passe-fort

# --- Redis (service Coolify Redis) --------------------------------------------
REDIS_URL=redis://redis:6379

# --- Medusa backend ----------------------------------------------------------
# DATABASE_URL est construit automatiquement par docker-compose.yml,
# mais pour Coolify (PostgreSQL en plugin), copier l'URL fournie par le plugin :
# DATABASE_URL=postgres://medusa:à-compléter@<host-coolify>:5432/medusa-store

# Secrets Medusa — générés via :
#   openssl rand -base64 32
JWT_SECRET=à-compléter-32-bytes-base64
COOKIE_SECRET=à-compléter-32-bytes-base64

# CORS — pour l'instant, Coolify sans domaine → HTTP localhost.
# ⚠️ Dès qu'un domaine est branché, REMPLACER par https://2tijen.com,...
STORE_CORS=http://localhost:8001,http://localhost:9000
ADMIN_CORS=http://localhost:8001,http://localhost:9000
AUTH_CORS=http://localhost:8001,http://localhost:9000

# --- Storefront (Next.js) ----------------------------------------------------
# URL INTERNE (réseau Coolify / compose) → utilisée par les rewrites /app,
# /admin, /store, /static, /health. C'est le seul truc que le conteneur
# storefront utilise pour parler au backend.
BACKEND_UPSTREAM_URL=http://backend:9000

# URL EXTERNE du backend (celle que le navigateur visite — gardé pour
# cohérence SDK/Medusa).
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# Clé publique Medusa (créée dans /app → Settings → API Keys) :
# pk_01J7Z0EMCQ4TPW2MB9WY9M48 (exemple ; remplacer par ta clé réelle)
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_à-compléter

NEXT_PUBLIC_DEFAULT_REGION=gf
NEXT_PUBLIC_BASE_URL=http://localhost:8001

# Hero / drop (vide pour l'instant — à compléter plus tard)
NEXT_PUBLIC_HERO_VIDEO_URL=
NEXT_PUBLIC_HERO_LOGO_URL=
NEXT_PUBLIC_NEXT_DROP_DATE=
NEXT_PUBLIC_STRIPE_KEY=

# --- Stockage images (optionnel) --------------------------------------------
# Si tu veux brancher Cloudflare R2 / AWS S3 plus tard, décommente et remplis.
# S3_BUCKET=
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=
