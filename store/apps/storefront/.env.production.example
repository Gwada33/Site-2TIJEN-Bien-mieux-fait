# ============================================================
# 2TIJEN — Storefront Next.js · Variables de production (Vercel)
# À coller dans Vercel → Project → Settings → Environment Variables
# (toutes en Production).
# NB : les NEXT_PUBLIC_* sont inlinées au build → redéploiement
# obligatoire après tout changement.
# ============================================================

# URL publique du backend Medusa (domaine Railway)
NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://api.2tijen.com

# Clé API publishable — Admin → Settings → API key management
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_xxxxxxxx

# Région par défaut (gf = Guadeloupe)
NEXT_PUBLIC_DEFAULT_REGION=gf

# URL du site (utilisée pour les liens canoniques / OG)
NEXT_PUBLIC_BASE_URL=https://2tijen.com

# Stripe (si activé en paiement, sinon vide)
NEXT_PUBLIC_STRIPE_KEY=

# Hero — vidéo + logo + date du prochain drop (optionnel)
NEXT_PUBLIC_HERO_VIDEO_URL=https://cdn.shopify.com/videos/c/o/v/375027fc8d1c4096adb00a4ad08b834d.mp4
NEXT_PUBLIC_HERO_LOGO_URL=
NEXT_PUBLIC_NEXT_DROP_DATE=
