# ============================================================
# 2TIJEN — Storefront Next.js · Variables à coller dans Vercel
# Vercel → Project → Settings → Environment Variables → Production.
# NB : les NEXT_PUBLIC_* sont inlinées au build → redéploiement
# obligatoire après tout changement.
# ============================================================

# Le site parle à SON propre domaine : /app, /admin, /store, /static et
# /health sont redirigés vers le backend Railway (voir next.config.js).
NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://2tijen.com

# URL "cachée" du backend Railway (seul Vercel y accède).
# En local (next dev), rien à mettre : on retombe sur localhost:9000.
BACKEND_UPSTREAM_URL=https://backend-production-xxxx.up.railway.app

# Clé API publishable — Admin → Settings → API key management
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_xxxxxxxx

# Région par défaut (gf = Guadeloupe)
NEXT_PUBLIC_DEFAULT_REGION=gf

# URL du site (liens canoniques / OG)
NEXT_PUBLIC_BASE_URL=https://2tijen.com

# Stripe (vide = paiement manuel)
NEXT_PUBLIC_STRIPE_KEY=

# Hero — vidéo + logo + date du prochain drop (optionnel)
NEXT_PUBLIC_HERO_VIDEO_URL=https://cdn.shopify.com/videos/c/o/v/375027fc8d1c4096adb00a4ad08b834d.mp4
NEXT_PUBLIC_HERO_LOGO_URL=
NEXT_PUBLIC_NEXT_DROP_DATE=
