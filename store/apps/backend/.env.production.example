# ============================================================
# 2TIJEN — Backend Medusa · Variables de production (Railway)
# Copie ce fichier dans les variables d'environnement du service
# Railway (pas de fichier .env en prod : tout passe par l'UI).
# ============================================================

# --- Base de données (plugin Railway Postgres, ou Neon/Supabase) ---
DATABASE_URL=postgres://user:pass@host:5432/medusa-store

# --- Redis (plugin Railway Redis — recommandé en prod) ---
# Optionnel : sans cette variable, un event bus in-memory est utilisé.
REDIS_URL=redis://default:pass@host:6379

# --- Secrets (génère-les : openssl rand -base64 32) ---
JWT_SECRET=change-me-32-bytes-random
COOKIE_SECRET=change-me-32-bytes-random

# --- CORS : domaines EXACTS du storefront et de l'admin ---
STORE_CORS=https://2tijen.com,https://www.2tijen.com
AUTH_CORS=https://2tijen.com,https://www.2tijen.com
ADMIN_CORS=https://api.2tijen.com

# --- Stockage des fichiers (Cloudflare R2 / AWS S3 / Scaleway) ---
# Recommandé : sans ça, les images uploadées vivent sur le disque
# éphémère du conteneur et disparaissent au redéploiement.
S3_BUCKET=
S3_PUBLIC_URL=https://cdn.2tijen.com
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Port (Railway l'injecte souvent via PORT) ---
PORT=9000
