# ============================================================
# 2TIJEN — Backend Medusa · Variables pour ton hébergeur de backend
# (Railway, Render, Fly.io… — le backend n'est PAS sur Vercel).
# Le backend est CACHÉ (pas de domaine public) : seul Vercel y accède,
# via les rewrites du storefront (/app, /admin, /store, /static, /health).
# ============================================================

# --- Base de données Postgres (Neon, Supabase ou plugin de l'hébergeur) ---
DATABASE_URL=postgres://user:pass@host:5432/medusa-store

# --- Redis (Upstash, ou plugin de l'hébergeur) ---
# Optionnel : sans cette variable, un event bus in-memory est utilisé.
REDIS_URL=redis://default:pass@host:6379

# --- Secrets (génère-les : openssl rand -base64 32) ---
JWT_SECRET=change-me-32-bytes-random
COOKIE_SECRET=change-me-32-bytes-random

# --- CORS : le domaine PUBLIC du site (le backend reçoit son Origin) ---
STORE_CORS=https://2tijen.com,https://www.2tijen.com
AUTH_CORS=https://2tijen.com,https://www.2tijen.com
ADMIN_CORS=https://2tijen.com

# --- Port (Railway l'injecte via PORT) ---
PORT=9000
